<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CCordTheme" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">#141417</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">#00000000</item>
        <item name="android:navigationBarColor">#00000000</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
    </style>

    <style name="CCordSplashTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#141417</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/CCordTheme</item>
    </style>
</resources>
